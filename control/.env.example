# Database
DATABASE_URL=./data/kakuremichi.db

# Server
PORT=3000
NODE_ENV=development

# WebSocket
WS_PORT=3001

# URL
PUBLIC_URL=http://localhost:3000

# Session Secret (32+ chars required, generate with: openssl rand -base64 48)
SESSION_SECRET=your-secret-key-here-replace-in-production-at-least-32-chars

# Initial admin bootstrap (used only when users table is empty).
# Leave blank to use the /setup wizard instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
